#!/usr/bin/env bash
# Releases the version currently in lib/flightdeck/version.rb:
#
#   1. preflight   — clean tree, on main, synced with origin, version not yet tagged
#   2. build       — bundle install, rake assets:build (auto-commits a rebuild if
#                    the version bump changed the banner), CHANGELOG sanity check
#   3. verify      — rubocop, fast suite in both host modes, system tests
#   4. push + CI   — push main, then wait for GitHub Actions to go green
#   5. publish     — tag vX.Y.Z, push the tag, gem build, gem push, GitHub release
#
# The order is deliberate: nothing irreversible (tag, rubygems, release) happens
# until CI has passed on the exact commit being released. RubyGems versions can
# never be reused, so the publish step asks for confirmation first.
#
#   bin/release              # full run
#   bin/release --dry-run    # everything except push, tag, gem push, gh release
set -euo pipefail

cd "$(dirname "$0")/.."

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

say()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
fail() { printf '\033[31merror: %s\033[0m\n' "$*" >&2; exit 1; }

VERSION=$(ruby -r./lib/flightdeck/version -e 'puts Flightdeck::VERSION')
TAG="v$VERSION"

# ---- 1. preflight ----------------------------------------------------------
say "Releasing flightdeck $VERSION"

[ "$(git branch --show-current)" = "main" ] || fail "not on main"
git diff --quiet && git diff --cached --quiet || fail "working tree is not clean"
git fetch origin main --tags --quiet
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "main is not in sync with origin/main — push or pull first"
git rev-parse -q --verify "refs/tags/$TAG" >/dev/null && fail "$TAG already exists — bump lib/flightdeck/version.rb first"
command -v gh >/dev/null || fail "gh CLI is required"

grep -q "\[$VERSION\]" CHANGELOG.md || fail "CHANGELOG.md has no [$VERSION] section"

# ---- 2. build --------------------------------------------------------------
say "Installing gems and rebuilding assets"
bundle install --quiet
bundle exec rake assets:build

if ! git diff --quiet -- app/assets/flightdeck Gemfile.lock; then
  # A version bump changes the built JS banner and the lockfile; anything else
  # dirty at this point is a real mistake caught by the preflight above.
  say "Committing rebuilt assets for $VERSION"
  git add app/assets/flightdeck Gemfile.lock
  git commit -m "Rebuild assets for $VERSION"
fi
bundle exec rake assets:check

# ---- 3. verify -------------------------------------------------------------
say "Rubocop"
bundle exec rubocop --parallel

say "Fast suite (full host)"
bundle exec rake test

say "Fast suite (API-only host)"
FLIGHTDECK_TEST_API_ONLY=1 bundle exec rake test

say "System tests"
bundle exec rake test:system

if [ "$DRY_RUN" = 1 ]; then
  say "Dry run complete — stopping before push/tag/publish"
  exit 0
fi

# ---- 4. push and wait for CI ----------------------------------------------
say "Pushing main"
git push origin main

say "Waiting for CI on $(git rev-parse --short HEAD)"
sleep 10
RUN_ID=$(gh run list --branch main --limit 1 --json databaseId --jq '.[0].databaseId')
gh run watch "$RUN_ID" --exit-status || fail "CI failed — nothing was tagged or published"

# ---- 5. publish ------------------------------------------------------------
printf '\nCI is green. Publish %s to RubyGems and tag %s? This cannot be undone. [y/N] ' "$VERSION" "$TAG"
read -r answer
[ "$answer" = "y" ] || [ "$answer" = "Y" ] || fail "aborted before publishing"

say "Tagging $TAG"
git tag -a "$TAG" -m "flightdeck $VERSION"
git push origin "$TAG"

say "Building and pushing the gem"
rm -f "flightdeck-$VERSION.gem"
gem build flightdeck.gemspec
gem push "flightdeck-$VERSION.gem"

say "Creating the GitHub release"
# Release notes: the CHANGELOG section for this version.
awk "/^## \[$VERSION\]/{flag=1; next} /^## \[/{flag=0} flag" CHANGELOG.md > /tmp/flightdeck-release-notes.md
gh release create "$TAG" "flightdeck-$VERSION.gem" \
  --title "flightdeck $VERSION" \
  --notes-file /tmp/flightdeck-release-notes.md

say "Released flightdeck $VERSION 🎉  Don't forget to start a new CHANGELOG section."
